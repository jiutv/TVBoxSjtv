@@ -0,0 +1,138 @@
+name: Build & Release TVBoxOS Mobile
+
+permissions:
+  contents: write
+  actions: write
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Generate tag
+        id: tag
+        run: |
+          TAG="$(git log --date=format:'%Y%m%d-%H%M' --pretty=format:'%cd' -1)"
+          SHORT="$(git rev-parse --short HEAD)"
+          echo "tag=$TAG-$SHORT" >> $GITHUB_OUTPUT
+          echo "tag=$TAG-$SHORT" >> $GITHUB_ENV
+
+      - name: Setup Java 17 (for sdkmanager)
+        uses: actions/setup-java@v5
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Setup Android SDK
+        run: |
+          export PATH=$PATH:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools
+          yes | sdkmanager --licenses
+          sdkmanager "platforms;android-33" "build-tools;30.0.3" "build-tools;33.0.2"
+
+      - name: Setup Java 11 (for Gradle build)
+        uses: actions/setup-java@v5
+        with:
+          distribution: temurin
+          java-version: '11'
+
+      - name: Pre-download Gradle 7.5 (mirror fallback)
+        run: |
+          GRADLE_VER="gradle-7.5-bin"
+          GRADLE_HOME="$HOME/.gradle/wrapper/dists/$GRADLE_VER"
+          HASH_DIR=$(echo -n "https://services.gradle.org/distributions/$GRADLE_VER.zip" | sha256sum | cut -c1-8)
+          TARGET="$GRADLE_HOME/$HASH_DIR"
+          if [ -d "$TARGET/gradle-7.5" ]; then
+            echo "✅ Gradle 7.5 已存在"
+          else
+            mkdir -p "$TARGET"
+            cd "$TARGET"
+            for url in \
+              "https://services.gradle.org/distributions/$GRADLE_VER.zip" \
+              "https://mirrors.cloud.tencent.com/gradle/$GRADLE_VER.zip" \
+              "https://mirrors.tuna.tsinghua.edu.cn/gradle/$GRADLE_VER.zip" \
+              "https://mirrors.huaweicloud.com/gradle/$GRADLE_VER.zip"; do
+              echo "  trying: $url"
+              if curl -fsSL --connect-timeout 10 -o "$GRADLE_VER.zip" "$url"; then
+                echo "✅ download ok: $url"
+                break
+              fi
+            done
+            unzip -q "$GRADLE_VER.zip"
+            rm -f "$GRADLE_VER.zip"
+            echo "✅ Gradle 7.5 ready"
+          fi
+
+      - uses: actions/cache@v4
+        with:
+          path: |
+            ~/.gradle/caches
+            ~/.m2/repository
+          key: gradle-build-${{ runner.os }}-${{ hashFiles('**/*.gradle', '**/*.gradle.kts', 'gradle.properties') }}
+          restore-keys: |
+            gradle-build-${{ runner.os }}-
+
+      - uses: gradle/actions/setup-gradle@v4
+
+      - name: Prepare build
+        run: |
+          echo "sdk.dir=${ANDROID_HOME}" > local.properties
+          sed -i '/^#org.gradle.jvmargs/s/^#//' gradle.properties
+          echo "local.properties:" && cat local.properties
+          echo "=== gradle.properties tail ===" && tail -5 gradle.properties
+
+      - name: Build With Gradle
+        run: |
+          chmod +x gradlew
+          ./gradlew assembleRelease \
+            --no-build-cache --stacktrace --warning-mode all
+
+      - name: Collect APKs
+        run: |
+          rm -rf apk/
+          mkdir -p apk/
+          echo "===== 🔍 Searching APKs ====="
+          find app/build/outputs/apk -name "*.apk" -print
+          for file in $(find app/build/outputs/apk -name "*.apk" -print); do
+            base=$(basename "$file")
+            new_base="TVBox_${base%.apk}_$tag.apk"
+            echo "  $file → apk/$new_base"
+            cp "$file" "apk/$new_base"
+          done
+          ls -la apk/
+          [ "$(ls apk/*.apk | wc -l)" -gt 0 ] || exit 1
+
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: TVBoxOS-Mobile-$tag
+          path: apk/*
+          if-no-files-found: warn
+
+      - name: Create GitHub Release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          gh release create "mobile-$tag" apk/*.apk \
+            --title "TVBoxOS Mobile $tag" \
+            --target "${{ github.sha }}" \
+            --latest
+
+  cleanup:
+    if: always()
+    needs: build
+    runs-on: ubuntu-latest
+    steps:
+      - uses: Mattraks/delete-workflow-runs@main
+        with:
+          token: ${{ github.token }}
+          repository: ${{ github.repository }}
+          retain_days: 14
+          keep_minimum_runs: 10
