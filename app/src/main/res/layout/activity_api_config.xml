<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212">

    <!-- 顶栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#FF1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="订阅管理"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTv"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="📺"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btnList"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="📋"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btnAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="＋"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Tab: 带下划线 -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1A1A1A"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:id="@+id/tabVodWrap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabVod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:text="点播订阅"
                android:textColor="#FFD4A04C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tabVodIndicator"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginBottom="4dp"
                android:background="#FFD4A04C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabLiveWrap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:text="直播订阅"
                android:textColor="#888888"
                android:textSize="15sp" />

            <View
                android:id="@+id/tabLiveIndicator"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginBottom="4dp"
                android:background="#00000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- 列表 -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabBar" />

</androidx.constraintlayout.widget.ConstraintLayout>
