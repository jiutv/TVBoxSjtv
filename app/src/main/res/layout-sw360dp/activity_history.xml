<?xml version="1.0" encoding="utf-8"?>
<!-- 手机版: 历史 + 收藏 合并, Tab 切换 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212"
    android:orientation="vertical">

    <!-- 顶栏: 标题 + Tab + 删除/清空 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 第一行: 历史/收藏 Tab + 清空按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/tabHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="历史"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabCollect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="收藏"
                android:textColor="#99FFFFFF"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/tvDelete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/button_nav_focus"
                android:contentDescription="删除模式"
                android:padding="4dp"
                android:src="@drawable/icon_delete" />

            <ImageView
                android:id="@+id/tvClear"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/button_nav_focus"
                android:contentDescription="清空"
                android:padding="4dp"
                android:src="@drawable/icon_clear" />
        </LinearLayout>

        <!-- 金色下划线 indicator -->
        <View
            android:id="@+id/tabIndicator"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginStart="25%"
            android:layout_marginEnd="75%"
            android:background="#FFD4A04C" />

        <!-- 删除提示文字 -->
        <TextView
            android:id="@+id/tvDelTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:text="删除模式: 点卡片删除 / 点清空按钮全部删除 / 返回退出"
            android:textColor="#FFFF8888"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 内容网格 -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        app:tv_selectedItemIsCentered="true"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
